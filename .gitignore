# Python
__pycache__/
*.pyc

# OS / editors
.DS_Store

# Simulation outputs are derived: regenerate them with the scripts (see AGENTS.md).
# Runs worth keeping go into results/, which is versioned.
runs/
# Every default output path points into runs/. These patterns catch outputs
# written into the code folders by hand (--output). JSON files are not
# ignored there: they can be sources (configs/ holds parameter files).
src/**/*.csv
src/**/*.gif
src/**/*.log
scripts/**/*.csv
scripts/**/*.gif
scripts/**/*.log
tests/**/*.csv
tests/**/*.gif
tests/**/*.log
# Old layout (before spec 002): outputs left on disk there after a pull stay
# ignored, so they cannot be committed by mistake.
03_Simulation_PyChrono/**/*.csv
03_Simulation_PyChrono/**/*.gif
03_Simulation_PyChrono/**/*.log
03_Simulation_PyChrono/test_*_granulobots*.json
